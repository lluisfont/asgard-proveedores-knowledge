{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "domain",
    "version",
    "dimensions",
    "score",
    "verdict",
    "blockers",
    "findings"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "object",
      "required": [
        "scope",
        "actors_permissions",
        "business_rules",
        "flows",
        "data_relations",
        "states",
        "integrations",
        "security",
        "transactions",
        "tests",
        "traceability",
        "artifact_consistency"
      ],
      "properties": {
        "scope": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "actors_permissions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "business_rules": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "flows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "data_relations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "states": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "integrations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "security": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "transactions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "tests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "traceability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "artifact_consistency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      },
      "additionalProperties": false
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "verdict": {
      "enum": [
        "PASS",
        "CONDITIONAL_PASS",
        "FAIL"
      ]
    },
    "blockers": {
      "type": "array"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "description"
        ],
        "properties": {
          "severity": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "BLOCKER"
            ]
          },
          "description": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
